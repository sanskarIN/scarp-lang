// Fit y = weight * x using an explicit squared-error gradient.
let inputs = [1.0, 2.0, 3.0];
let targets = [2.0, 4.0, 6.0];
let mut weight = 0.0;
let mut iteration = 0;
while iteration < 40 {
    let predictions = scale(inputs, weight);
    let residuals = add(predictions, scale(targets, -1.0));
    let gradient = (2.0 * dot(inputs, residuals)) / 3.0;
    weight -= 0.05 * gradient;
    iteration += 1;
}
println(weight > 1.999999 and weight < 2.000001);
println(mse(scale(inputs, weight), targets) < 1e-12);
