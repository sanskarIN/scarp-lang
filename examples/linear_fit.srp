// Fit y = weight * x using an explicit squared-error gradient.
bind inputs = [1.0, 2.0, 3.0];
bind targets = [2.0, 4.0, 6.0];
var weight = 0.0;
var iteration = 0;
while iteration < 40 {
    bind predictions = scale(inputs, weight);
    bind residuals = add(predictions, scale(targets, -1.0));
    bind gradient = (2.0 * dot(inputs, residuals)) / 3.0;
    weight -= 0.05 * gradient;
    iteration += 1;
}
println(weight > 1.999999 and weight < 2.000001);
println(mse(scale(inputs, weight), targets) < 1e-12);
