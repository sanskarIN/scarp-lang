// Native finite-vector kernels and immutable update values.
let features = [1.0, 2.0, 3.0];
let weights = [0.5, 0.25, -0.5];
println(dot(features, weights));
println(sum([1e16, 1.0, -1e16]));
println(softmax([1000.0, 1000.0]));
println(mse([1.0, 2.0], [1.0, 4.0]));
let updated = add(weights, scale(features, 0.1));
println(len(updated));
println(clamp(updated, 0.0, 1.0));
