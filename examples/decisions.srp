// Conditions are booleans; each body introduces a lexical scope.
let score = 73;
let mut grade = "pending";
if score >= 90 {
    grade = "A";
} elif score >= 60 and score < 90 {
    grade = "B";
} else {
    grade = "C";
}
println(grade);
if true or 1 / 0 == 0 {
    let message = "Selected safely.";
    println(message);
}
